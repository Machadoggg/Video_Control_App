<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a">

    <!-- Fondo textura igual al splash -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="4"
        android:rowCount="7"
        android:alpha="0.25">
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#222222"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#252525"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#151515"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#222222"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#252525"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#151515"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#222222"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#151515"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#252525"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#2a2a2a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#222222"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#111111"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#1a1a1a"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="#252525"/>
    </GridLayout>

    <!-- Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"/>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp"
            android:paddingTop="60dp">

            <!-- Logo pequeño -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/circle_red_border"/>

                <ImageView
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_launcher_round"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_black"/>
            </FrameLayout>

            <!-- Nombre del bar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAR-RACUDA"
                android:textColor="@color/accent_blue"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:shadowColor="#000000"
                android:shadowRadius="6"
                android:shadowDx="2"
                android:shadowDy="2"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLÁSICOS"
                android:textColor="#C8A020"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="40dp"/>

            <!-- Card de login -->
            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1a1a1a"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Línea roja superior -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/accent_blue"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceso Vídeo Control DJ"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="20dp"
                        android:layout_gravity="center"/>

                    <!-- Label contraseña -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONTRASEÑA"
                        android:textColor="#666666"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="8dp"/>

                    <!-- Campo contraseña -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/input_bg_dark"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="16sp"
                            android:paddingStart="14dp"
                            android:paddingEnd="8dp"/>

                        <EditText
                            android:id="@+id/passwordInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:inputType="textPassword"
                            android:textColor="#f0f0ff"
                            android:textColorHint="#444466"
                            android:hint="Ingresa la contraseña"
                            android:textSize="15sp"
                            android:imeOptions="actionDone"
                            android:paddingEnd="14dp"/>
                    </LinearLayout>

                    <!-- Mensaje de error -->
                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠  Contraseña incorrecta"
                        android:textColor="#FF4444"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone"/>

                    <!-- Botón entrar -->
                    <Button
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Ingresar"
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:backgroundTint="@color/accent_blue"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Decoración inferior -->
            <View
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:background="@color/accent_red"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rock · metal · clásicos"
                android:textColor="#888888"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="32dp"/>

            <!-- Versión -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0"
                android:textColor="#444444"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <!-- Desarrollador -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developed by DharmaCode"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <!-- Derechos reservados -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026 DharmaCode · All rights reserved"
                android:textColor="#333333"
                android:textSize="10sp"
                android:letterSpacing="0.03"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
