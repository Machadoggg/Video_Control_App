            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ MODOS DE REPRODUCCIÓN ════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <ToggleButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_dark"
                    android:textColor="@color/accent_blue"
                    android:textOn="🔂 Repetir"
                    android:textOff="🔂 Repetir"
                    android:textSize="11sp"
                    android:checked="false"
                    android:layout_marginEnd="6dp"/>

                <ToggleButton
                    android:id="@+id/btnRandom"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_dark"
                    android:textColor="@color/accent_blue"
                    android:textOn="🔀 Aleatorio"
                    android:textOff="🔀 Aleatorio"
                    android:textSize="11sp"
                    android:checked="false"
                    android:layout_marginEnd="6dp"/>

                <ToggleButton
                    android:id="@+id/btnLoop"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/card_dark"
                    android:textColor="@color/accent_blue"
                    android:textOn="🔁 Bucle"
                    android:textOff="🔁 Bucle"
                    android:textSize="11sp"
                    android:checked="false"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>



    </LinearLayout>
</ScrollView>
