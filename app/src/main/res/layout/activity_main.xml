<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/accent_blue"
        app:titleTextColor="@android:color/white" />

    <!-- ── Panel Videos ── -->
    <LinearLayout
        android:id="@+id/panelVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/card_dark">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/bg_dark"
                android:hint="Buscar vídeo..."
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="#777" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Buscar"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp"
            android:background="@color/card_dark">

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@color/accent_blue" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="@color/accent_blue"
                android:text="🔄" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬  VÍDEOS DISPONIBLES"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/videosRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- ── Panel Cola ── -->
    <LinearLayout
        android:id="@+id/panelQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋  LISTA DE REPRODUCCIÓN"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/card_dark">

            <Button
                android:id="@+id/playQueueButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="▶"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/playNextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="20sp"
                android:text="▶|"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/shuffleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="20sp"
                android:text="🔀"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/clearQueueButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="20sp"
                android:text="🗑️"
                android:backgroundTint="@color/accent_red"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Panel Solicitudes ── -->
    <LinearLayout
        android:id="@+id/panelRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Cabecera con título y botón de refrescar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <!--<TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎵  SOLICITUDES"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />-->

            <TextView
                android:id="@+id/pendingCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/requestsRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🔄 Actualizar"
                android:textSize="11sp"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/requestsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- ── Panel Reproductor ── -->
    <include
        android:id="@+id/panelPlayer"
        layout="@layout/fragment_player"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        app:itemIconTint="@color/nav_selector"
        app:itemTextColor="@color/nav_selector"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
