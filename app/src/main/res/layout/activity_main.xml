       <!-- <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊  Volumen"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <SeekBar
            android:id="@+id/volumeSeekBar"
            android:layout_width="match_parent"
