<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/accent_blue"
        app:titleTextColor="@android:color/white" />

    <!-- ── Panel Videos ── -->
    <LinearLayout
        android:id="@+id/panelVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/card_dark">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="275dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@color/bg_dark"
                android:hint="Buscar vídeo..."
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textColorHint="#777" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Buscar"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white"
                android:layout_marginStart="6dp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp"
            android:background="@color/card_dark">

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="260dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="0dp"
                android:background="@color/accent_blue" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginRight="2dp"
                android:backgroundTint="@color/accent_blue"
                android:text="🔄" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎬  VÍDEOS DISPONIBLES"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/videosRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- ── Panel Cola ── -->
    <LinearLayout
        android:id="@+id/panelQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/card_dark">

            <Button
                android:id="@+id/playQueueButton"
                android:layout_width="0dp"
                android:textSize="20dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/playNextButton"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:textSize="20dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶|"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/shuffleButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_height="wrap_content"
                android:text="▶ 🔀"
                android:textSize="20dp"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/white" /> />

            <Button
                android:id="@+id/clearQueueButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="20dp"
                android:text="🗑️"
                android:backgroundTint="@color/accent_red"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋  LISTA DE REPRODUCCIÓN"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- ── Panel Reproductor ── -->
    <LinearLayout
        android:id="@+id/panelPlayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Ícono pantalla -->
        <!--<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥"
            android:textSize="40sp"
            android:layout_marginBottom="8dp" />-->

